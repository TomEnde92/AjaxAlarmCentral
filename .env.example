# Kopieer naar .env en vul in. .env staat in .gitignore en hoort daar te blijven.

# ── Ajax SIA DC-09 ────────────────────────────────────────────────────────────
# Dezelfde encryptiesleutel als in de Ajax-app onder Meldkamer.
# 16, 24 of 32 ASCII-tekens. Leeglaten = onversleuteld (sterk afgeraden).
AJAXCENTRAL_SIA_KEY=verander-dit-nu-16ch

# ── Netwerk ───────────────────────────────────────────────────────────────────
# Het LAN-adres van de Pi. Poorten 10000 en 8080 worden alleen op dit adres
# opengezet (zie docker-compose.yml). Leeg = alle interfaces.
AJAXCENTRAL_BIND_ADDRESS=

# ── Web-dashboard ─────────────────────────────────────────────────────────────
# Genereer de hash met:  python -m ajaxcentral.web.auth hash 'jouwwachtwoord'
AJAXCENTRAL_WEB_PASSWORD_HASH=
# Sleutel voor de sessie-cookies. Genereer met: openssl rand -hex 32
AJAXCENTRAL_WEB_SECRET=

# ── MQTT (optioneel) ──────────────────────────────────────────────────────────
AJAXCENTRAL_MQTT_USERNAME=
AJAXCENTRAL_MQTT_PASSWORD=
